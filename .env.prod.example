# ===== Claves core =====
SECRET_KEY=changeme-super-secret
JWT_SECRET_KEY=changeme-jwt-secret
ENCRYPTION_KEY=changeme-fernet-key
LOG_LEVEL=INFO

# ===== Base de datos y cache =====
DATABASE_URL=postgresql://ispmax:STRONGPASS@postgres:5432/ispmax
DB_PASSWORD=STRONGPASS
REDIS_URL=redis://:REDISPASS@redis:6379/0
REDIS_PASSWORD=REDISPASS

# ===== Dominios y CORS =====
FRONTEND_HOST=panel.midominio.com
API_URL=https://api.midominio.com
API_HOST=api.midominio.com
CORS_ORIGINS=https://panel.midominio.com
TRAEFIK_ACME_EMAIL=admin@midominio.com
TENANCY_ROOT_DOMAIN=midominio.com
TENANCY_MASTER_HOST=master.midominio.com
TENANCY_API_HOST=api.midominio.com
TENANCY_EXCLUDED_SUBDOMAINS=api,master,www
TENANCY_ENFORCE_HOST_MATCH=false

# ===== MikroTik / OLT (solo prueba, cambia en prod) =====
MIKROTIK_DEFAULT_USERNAME=admin
MIKROTIK_DEFAULT_PASSWORD=changeme
MIKROTIK_WG_ENDPOINT=vpn.fastisp.cloud:51820
MIKROTIK_WG_SERVER_PUBLIC_KEY=
MIKROTIK_WG_ALLOWED_SUBNETS=10.250.0.0/16,10.251.0.0/16
MIKROTIK_WG_VPS_SYNC_MODE=ssh
MIKROTIK_WG_VPS_INTERFACE=wg0
MIKROTIK_WG_VPS_PERSIST=true
MIKROTIK_WG_VPS_SSH_HOST=127.0.0.1
MIKROTIK_WG_VPS_SSH_PORT=22
MIKROTIK_WG_VPS_SSH_USER=root
MIKROTIK_WG_VPS_SSH_PASSWORD=
MIKROTIK_WG_VPS_SSH_KEY_PATH=/home/ispmax/.ssh/id_ed25519
MIKROTIK_WG_VPS_SSH_TIMEOUT_SECONDS=8
MIKROTIK_WG_VPS_SSH_USE_SUDO=true
ROTATE_PASSWORDS_DRY_RUN=false
PASSWORD_ROTATION_LENGTH=24
OLT_DEFAULT_PASSWORD=changeme

# ===== InfluxDB (telemetría) =====
INFLUXDB_URL=https://influx.midominio.com
INFLUXDB_TOKEN=changeme
INFLUXDB_ORG=ispmax
INFLUXDB_BUCKET=network

# ===== Pagos =====
# Pagos deshabilitados (Stripe removido por ahora)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=

# ===== Correo =====
MAIL_USERNAME=notificaciones@midominio.com
MAIL_PASSWORD=changeme

# ===== Grafana =====
GRAFANA_PASSWORD=SuperSegura123

# ===== Workers =====
GUNICORN_WORKERS=4

# ===== Backups =====
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=14
PG_DUMP_PATH=pg_dump

# ===== OpenAI (opcional) =====
OPENAI_API_KEY=sk-xxx
FRONTEND_URL=https://panel.midominio.com
ALLOW_SELF_SIGNUP=false
ALLOW_DEMO_LOGIN=false
ALLOW_PAYMENT_DEMO=false
ALLOW_OLT_DEMO=false

ALLOW_GOOGLE_LOGIN=true
ALLOW_INSECURE_GOOGLE_LOGIN=false
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
API_HOST=api.fastisp.cloud
WAF_IP_ALLOWLIST=10.0.0.0/8,192.168.0.0/16
